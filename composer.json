{
    "name": "cskiller/filament-id-generator",
    "description": "A Filament plugin for bulk ID card generation with a visual template editor",
    "keywords": [
        "cskiller",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-id-generator"
    ],
    "homepage": "https://github.com/cskiller/filament-id-generator",
    "support": {
        "issues": "https://github.com/cskiller/filament-id-generator/issues",
        "source": "https://github.com/cskiller/filament-id-generator"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "cedy cadayong",
            "email": "cadayongcs@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.0",
        "filament/filament": "^5.0",
        "intervention/image": "^3.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "spatie/pdf-to-image": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Cskiller\\FilamentIdGenerator\\": "src/",
            "Cskiller\\FilamentIdGenerator\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cskiller\\FilamentIdGenerator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "vendor/bin/phpunit",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cskiller\\FilamentIdGenerator\\FilamentIdGeneratorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
